  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.441",
    "@remotion/cli": "4.0.441",
    "@remotion/renderer": "4.0.441",
    "ast-types": "^0.16.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.441"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2"
  }
