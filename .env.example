POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
POSTGRES_DB=creatorflow
POSTGRES_USER=creatorflow
POSTGRES_PASSWORD=creatorflow
POSTGRES_PORT=5433
REDIS_IMAGE=public.ecr.aws/docker/library/redis:7.4-alpine
REDIS_PORT=6380
API_GATEWAY_PORT=4000
WEB_UI_PORT=3000
MEDIA_PROCESSING_PORT=4100
PUBLISHING_SERVICE_PORT=4200
DATABASE_URL=postgresql://creatorflow:creatorflow@localhost:5433/creatorflow
REDIS_URL=redis://localhost:6380
API_GATEWAY_SERVER_BASE_URL=http://localhost:4000
APP_WEB_BASE_URL=http://localhost:3000
ACCESS_TOKEN_SECRET=creatorflow-dev-secret
ACCESS_TOKEN_ISSUER=creatorflow-api-gateway
ACCESS_TOKEN_AUDIENCE=creatorflow-web
ACCESS_TOKEN_EXPIRES_IN=15m
ACCESS_TOKEN_COOKIE_NAME=creatorflow_access_token
ACCESS_TOKEN_COOKIE_MAX_AGE_SECONDS=900
REFRESH_TOKEN_COOKIE_NAME=creatorflow_refresh_token
REFRESH_TOKEN_MAX_AGE_SECONDS=2592000
OAUTH_FLOW_MAX_AGE_SECONDS=600
AUTH_OTP_MAX_AGE_SECONDS=900
PASSWORD_RESET_OTP_MAX_AGE_SECONDS=900
REFRESH_TOKEN_SECURE=false
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_FROM=auth@notify.creatorflow.local
RESEND_API_KEY=
FAL_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
SSO_PLACEHOLDER_EMAIL_DOMAIN=sso.creatorflow.local
INTERNAL_SERVICE_SECRET=creatorflow-internal-dev-secret
INTERNAL_SERVICE_ISSUER=creatorflow-api-gateway
INTERNAL_SERVICE_AUDIENCE=creatorflow-internal
INTERNAL_SERVICE_EXPIRES_IN=5m
INTERNAL_TOKEN_BOOTSTRAP_SECRET=creatorflow-internal-bootstrap-secret
MEDIA_PROCESSING_INTERNAL_AUDIENCE=creatorflow-media-processing-service
PUBLISHING_SERVICE_INTERNAL_AUDIENCE=creatorflow-publishing-service
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@creatorflow.local
BOOTSTRAP_SUPERADMIN_PASSWORD=creatorflow-dev-superadmin
BOOTSTRAP_SUPERADMIN_FULL_NAME=CreatorFlow Superadmin
BOOTSTRAP_SUPERADMIN_WORKSPACE_NAME=CreatorFlow Control Room
BOOTSTRAP_SUPERADMIN_WORKSPACE_SLUG=creatorflow-control-room
