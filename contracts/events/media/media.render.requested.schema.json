{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "media.render.requested",
  "type": "object",
  "required": [
    "eventName",
    "eventVersion",
    "occurredAt",
    "jobId",
    "workspaceId",
    "sourceAssetId"
  ],
  "properties": {
    "eventName": {
      "const": "media.render.requested"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceAssetId": {
      "type": "string",
      "format": "uuid"
    },
    "scriptId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
