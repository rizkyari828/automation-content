{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trend.digest.generated",
  "type": "object",
  "required": [
    "eventName",
    "eventVersion",
    "occurredAt",
    "digestId",
    "workspaceId",
    "period"
  ],
  "properties": {
    "eventName": {
      "const": "trend.digest.generated"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "digestId": {
      "type": "string",
      "format": "uuid"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "period": {
      "type": "string",
      "enum": ["daily", "weekly"]
    }
  },
  "additionalProperties": false
}
