{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorflow.local/contracts/media/template-scene-plan.schema.json",
  "title": "template.scene.plan",
  "type": "object",
  "required": [
    "version",
    "templateKey",
    "aspectRatio",
    "scenes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "templateKey": {
      "type": "string"
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["9:16", "1:1", "16:9"]
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "musicCue": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "clean", "upbeat", "dramatic"]
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "durationFrames"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["hook", "problem", "benefit", "offer", "proof", "cta", "closing"]
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1
          },
          "backgroundAssetId": {
            "type": "string",
            "format": "uuid"
          },
          "layout": {
            "type": "string",
            "enum": ["hero", "split", "stacked", "product-focus", "caption-led"]
          },
          "textBlocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["headline", "supporting", "price", "offer", "cta", "caption"]
                },
                "animation": {
                  "type": "string",
                  "enum": ["fade", "slide-up", "pop", "type", "none"]
                }
              },
              "additionalProperties": false
            }
          },
          "subtitleCue": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "endFrame": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
